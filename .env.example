# Local development. Export these variables before starting Django.
# Django does not load this file automatically.
DEBUG=True
ALLOWED_HOSTS='localhost 127.0.0.1'

# Required for production: generate a unique key and set DEBUG=False.
# SECRET_KEY=replace-with-a-random-secret

# Omit DATABASE_URL to use local SQLite.
# On Railway, reference the PostgreSQL service: ${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://user:password@host:5432/dbname
